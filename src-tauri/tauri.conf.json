{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VN Script Editor",
  "version": "0.6.0",
  "identifier": "com.vnscripteditor.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run vite",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VN Script Editor",
        "width": 1400,
        "height": 900,
        "backgroundColor": "#1e1e1e",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyMTA3ODJBNjlCREJFMkUKUldRdXZyMXBLbmdRc2dGZEdPNHVLV1FWbm9ySkN0bmR4MjhtZzhFZURCd2w1Sk1qZlVIeHErWjUK",
      "endpoints": [
        "https://github.com/ChenghsichengGit/vn-script-editor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
